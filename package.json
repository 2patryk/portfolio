{
  "name": "nextjs",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "generate-planets": "rm -f public/images/pano/planets/*.jpg && node scripts/generate-planet-thumbs.js",
    "dev": "node scripts/generate-planet-thumbs.js && next dev",
    "build": "node scripts/generate-planet-thumbs.js && next build",
    "start": "next start",
    "lint": "eslint .",
    "new-component": "node ./scripts/component.js",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@ariakit/react": "^0.4.43",
    "@next/third-parties": "^16.4.6",
    "@photo-sphere-viewer/autorotate-plugin": "^5.15.1",
    "@photo-sphere-viewer/core": "^5.15.1",
    "@photo-sphere-viewer/markers-plugin": "^5.15.1",
    "date-fns": "^4.4.0",
    "framer-motion": "^14.14.0",
    "next": "^16.4.6",
    "polished": "^4.3.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-photo-sphere-viewer": "^6.2.3",
    "slugify": "^1.6.9",
    "styled-components": "^6.6.0",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@storybook/addon-docs": "^10.6.7",
    "@storybook/addon-links": "^10.6.7",
    "@storybook/addon-onboarding": "^10.6.7",
    "@storybook/addon-themes": "^10.6.7",
    "@storybook/nextjs-vite": "^10.6.7",
    "@svgr/webpack": "^8.1.0",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "autoprefixer": "^10.6.2",
    "eslint": "^10.15.0",
    "eslint-config-next": "^16.4.6",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-storybook": "^10.6.7",
    "maxstache": "1.0.7",
    "minimist": "1.2.8",
    "postcss": "^8.5.33",
    "sharp": "^0.35.5",
    "storybook": "^10.6.7",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vite": "^8.3.8",
    "vite-plugin-svgr": "^5.2.0"
  },
  "engines": {
    "node": ">=24"
  },
  "overrides": {
    "eslint-plugin-react": {
      "eslint": "$eslint"
    },
    "eslint-plugin-import": {
      "eslint": "$eslint"
    },
    "eslint-plugin-jsx-a11y": {
      "eslint": "$eslint"
    }
  }
